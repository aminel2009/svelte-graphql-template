{
	"name": "svelte-graphql-template",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"devsafe": "rm -rf .svelte-kit node_modules/.vite && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"generate": "graphql-codegen",
		"generate:watch": "graphql-codegen --watch",
		"update:svelte": "pnpm update \"@sveltejs/*\" svelte svelte-check vite tailwindcss @tailwindcss/vite --latest && pnpm run prepare",
		"update:graphql": "pnpm update \"@graphql-codegen/*\" graphql graphql-request graphql-tag --latest",
		"update:deps": "pnpm update --latest && pnpm run prepare"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@graphql-codegen/cli": "^8.0.0",
		"@graphql-codegen/typescript": "^7.0.1",
		"@graphql-codegen/typescript-graphql-request": "^8.0.0",
		"@graphql-codegen/typescript-operations": "^7.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"graphql": "^16.15.0",
		"graphql-request": "^7.4.0",
		"graphql-tag": "^2.12.7"
	},
	"engines": {
		"node": "^22.17.0 || >=24.0.0",
		"pnpm": "^9 || ^10 || ^11"
	}
}
